resolver 127.0.0.11 valid=10s ipv6=off;
upstream preview_api {
    zone preview_api 64k;
    server app:8000 resolve;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv;
    index index.html;
    client_max_body_size 24k;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Autosim-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_pass http://preview_api;
    }
    location = /preview-health { return 200 "ok\n"; }
    location = /apple { return 302 /; }
    location = /apple/ { return 302 /; }
    location = /cabinet { try_files /cabinet.html =404; }
    location = /cabinet/ { try_files /cabinet.html =404; }
    location = /adminka { try_files /adminka.html =404; }
    location = /adminka/ { try_files /adminka.html =404; }
    location = /source { try_files /source.html =404; }
    location = /source/ { try_files /source.html =404; }
    location ~ /\. { return 404; }
    location / { try_files $uri $uri/ =404; }
}
