resolver 127.0.0.11 valid=10s ipv6=off;
upstream live_api {
    zone live_api 64k;
    server app:8000 resolve;
    keepalive 16;
}

server {
    listen 8080;
    server_name ${DOMAIN};
    server_tokens off;
    root /srv;
    index index.html;
    client_max_body_size 24k;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org wss://mc.yandex.ru wss://mc.yandex.az wss://mc.yandex.by wss://mc.yandex.co.il wss://mc.yandex.com wss://mc.yandex.com.am wss://mc.yandex.com.ge wss://mc.yandex.com.tr wss://mc.yandex.ee wss://mc.yandex.fr wss://mc.yandex.kg wss://mc.yandex.kz wss://mc.yandex.lt wss://mc.yandex.lv wss://mc.yandex.md wss://mc.yandex.tj wss://mc.yandex.tm wss://mc.yandex.uz wss://mc.webvisor.com wss://mc.webvisor.org; child-src 'self' blob: https://mc.yandex.ru; frame-src 'self' blob: https://mc.yandex.ru; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors https://metrika.yandex.ru https://metrica.yandex.ru https://metrika.yandex.com https://metrica.yandex.com https://webvisor.com https://*.webvisor.com; form-action 'self'" always;

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Autosim-Client-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_pass http://live_api;
    }
    location = /live-health { return 200 "ok\n"; }
    location = /apple { return 302 /; }
    location = /apple/ { return 302 /; }
    location = /cabinet { try_files /cabinet.html =404; }
    location = /cabinet/ { try_files /cabinet.html =404; }
    location = /adminka { try_files /adminka.html =404; }
    location = /adminka/ { try_files /adminka.html =404; }
    location = /source { try_files /source.html =404; }
    location = /source/ { try_files /source.html =404; }
    location ~ /\. { return 404; }
    location / { try_files $uri $uri/ =404; }
}
