# Run python3 scripts/setup.py. Never publish the generated .env.
DOMAIN=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ALLOWED_ORIGINS=
DATABASE_PATH=/data/autosim.sqlite3
TRUST_REVERSE_PROXY=1
SMARTSHELL_WRITE_CLUB_ID=
BOOKING_BRIDGE_SECRET=
BOOKING_OWNER_ID=
TELEGRAM_OWNER_IDS=
TELEGRAM_BOT_TOKEN=
SOURCE_PASSWORD_HASH=

# Same admin chat as the previous website; supports private chats or groups.
TELEGRAM_ADMIN_CHAT_ID=
# Use polling only after the previous bot receiver has been stopped.
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_PROXY_URL=
# Required for TELEGRAM_UPDATE_MODE=webhook; generate a random 32+ character value.
TELEGRAM_WEBHOOK_SECRET=
